# Local : postgresql+psycopg://gytev:gytev@localhost:5432/gytev
# Neon  : postgresql://neondb_owner:<pwd>@ep-xxx-pooler.c-x.aws.neon.tech/neondb?sslmode=require
#         (le driver async psycopg est ajouté automatiquement)
DATABASE_URL=postgresql+psycopg://gytev:gytev@localhost:5432/gytev
GYTEV_ENVIRONMENT=development
GYTEV_DEBUG=true
GYTEV_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
GYTEV_ADMIN_API_KEY=dev-secret-change-me

# ── Email (contact form) ──────────────────────────────────────────────
# Si SMTP_HOST n'est pas défini, les emails ne sont pas envoyés (mode dev).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# FROM_EMAIL=noreply@gytev.com
#
# Adresses de destination (une par topic) :
#   team          → hello@gytev.com
#   support       → support@gytev.com
#   press         → press@gytev.com
#   privacy       → sales@gytev.com
#   vulnerability → security@gytev.com
